# Settings and credentials for the local stack.
#
# ./deploy.sh copies this file to .env on first run and fills every empty
# *_PASSWORD with a random value. To choose your own, create .env yourself
# (or edit it) before deploying. .env is git-ignored; never commit it.

# MySQL (source database)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=admin
MYSQL_PASSWORD=

# MySQL user the Debezium connector reads the binlog with
DEBEZIUM_DB_PASSWORD=

# ClickHouse (analytics database)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Grafana admin login (the dashboard itself is viewable without login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
