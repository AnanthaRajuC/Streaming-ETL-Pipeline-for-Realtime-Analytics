    {
      "type": "geomap",
      "title": "Where people live",
      "description": "One marker per current person, from the coordinates of their address's geo row.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.0",
          "rawSql": "SELECT LAT AS latitude, LNG AS longitude, FIRST_NAME AS first_name, CITY AS city\nFROM KafkaEngine.person_address_enriched FINAL WHERE IS_DELETED = 0 AND LAT IS NOT NULL AND LNG IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "zoom": 1,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "People",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
