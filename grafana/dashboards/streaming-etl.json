    {
      "type": "timeseries",
      "title": "New people per interval",
      "description": "People created in MySQL, by creation time. Seed data appears as one bar at deploy time.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.22.0",
          "rawSql": "SELECT assumeNotNull($__timeInterval(CREATED_AT)) AS time, count() AS new_people\nFROM KafkaEngine.person_address_enriched FINAL WHERE IS_DELETED = 0 AND $__timeFilter(CREATED_AT)\nGROUP BY time\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 90,
            "lineWidth": 0,
            "barAlignment": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 5,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
