    {
      "type": "barchart",
      "title": "Age groups",
      "description": "Current people by age decade.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.0",
          "rawSql": "SELECT concat(toString(intDiv(AGE, 10) * 10), '-', toString(intDiv(AGE, 10) * 10 + 9)) AS age_group, count() AS people\nFROM KafkaEngine.person_address_enriched FINAL WHERE IS_DELETED = 0 AND AGE IS NOT NULL\nGROUP BY age_group\nORDER BY age_group"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "age_group",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0
      },
      "id": 8,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
