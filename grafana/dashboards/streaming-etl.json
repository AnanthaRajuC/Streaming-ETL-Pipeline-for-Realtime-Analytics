    {
      "type": "table",
      "title": "Recently changed people",
      "description": "The 20 most recently created or updated current people.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.0",
          "rawSql": "SELECT P_ID AS id, FIRST_NAME AS first_name, LAST_NAME AS last_name, CITY AS city, STATE AS state, AGE AS age, UPDATED_AT AS updated_at\nFROM KafkaEngine.person_address_enriched FINAL WHERE IS_DELETED = 0\nORDER BY UPDATED_AT DESC, P_ID DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
