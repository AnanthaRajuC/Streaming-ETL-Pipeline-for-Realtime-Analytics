    {
      "type": "barchart",
      "title": "Top cities",
      "description": "Cities with the most current people. People without an address count as Unknown.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.0",
          "rawSql": "SELECT ifNull(CITY, 'Unknown') AS city, count() AS people\nFROM KafkaEngine.person_address_enriched FINAL WHERE IS_DELETED = 0\nGROUP BY city\nORDER BY people DESC, city\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "city",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0
      },
      "id": 6,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
