            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.22.0",
          "rawSql": "SELECT ifNull(STATE, 'Unknown') AS state, count() AS people\nFROM KafkaEngine.person_address_enriched FINAL WHERE IS_DELETED = 0\nGROUP BY state\nORDER BY people DESC, state\nLIMIT 10"
